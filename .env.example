
# =====================================================
# YOUTUBE DATA LAKEHOUSE
# ENVIRONMENT TEMPLATE
# =====================================================

# =====================================================
# 1. POSTGRESQL
# =====================================================

POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=airflow_db
POSTGRES_PORT=5432

# =====================================================
# 2. SILO OBJECT STORAGE
# =====================================================

MINIO_ROOT_USER=youtube_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=youtube-lakehouse

# =====================================================
# 3. HIVE METASTORE
# =====================================================

HIVE_DB_USER=hive_user
HIVE_DB_PASSWORD=CHANGE_ME_HIVE_PASSWORD
HIVE_DB_NAME=hive_metastore
HIVE_METASTORE_PORT=9083

# =====================================================
# 4. KAFKA
# =====================================================

KAFKA_BROKER_ID=1
KAFKA_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_CLUSTER_ID=GENERATE_VALID_KAFKA_CLUSTER_ID

# =====================================================
# 5. DEBEZIUM
# =====================================================

DEBEZIUM_DB_USER=debezium_user
DEBEZIUM_DB_PASSWORD=CHANGE_ME_DEBEZIUM_PASSWORD

CONNECT_PORT=8083
CONNECT_GROUP_ID=1
CONNECT_CONFIG_TOPIC=connect_configs
CONNECT_OFFSET_TOPIC=connect_offsets
CONNECT_STATUS_TOPIC=connect_statuses

# =====================================================
# 6. AIRFLOW
# =====================================================

AIRFLOW_VERSION=2.10.5
AIRFLOW_UID=50000
AIRFLOW_EXECUTOR=LocalExecutor

AIRFLOW_WEBSERVER_PORT=8080

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_PASSWORD

AIRFLOW_FERNET_KEY=GENERATE_VALID_FERNET_KEY
